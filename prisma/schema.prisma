// Schéma de base de données du site de la bijouterie.
// Montants en FCFA (entiers, sans décimales).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum AppointmentStatus {
  NEW
  CONFIRMED
  DONE
  CANCELED
}

// Compte d'accès à l'administration (créé par « npm run db:seed »).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
}

// Catalogue : un bijou présenté sur le site. La photo est stockée dans la base (4 Mo maximum).
model Bijou {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String // bagues, colliers, boucles, bracelets, parures (voir src/lib/site.ts)
  material    String   @default("") // ex. « Or 18 carats, diamant »
  description String   @default("")
  priceXof    Int? // vide = « Prix sur demande »
  photo       Bytes?
  photoType   String?
  featured    Boolean  @default(false) // affiché sur l'accueil
  active      Boolean  @default(true) // masqué du site si false
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Demandes envoyées depuis le site : rendez-vous (kind = "RDV") ou message (kind = "CONTACT").
model AppointmentRequest {
  id            String            @id @default(cuid())
  kind          String            @default("CONTACT")
  name          String
  phone         String
  email         String?
  subject       String
  piece         String? // bijou qui intéresse le visiteur
  message       String?
  status        AppointmentStatus @default(NEW)
  wantedDate    String? // jour proposé par le visiteur, AAAA-MM-JJ
  wantedTime    String? // heure proposée, HH:MM
  confirmedDate String? // jour confirmé par la boutique
  confirmedTime String? // heure confirmée par la boutique
  createdAt     DateTime          @default(now())
}

// Coordonnées du site modifiables depuis /admin (clé = telephone, whatsapp, email, adresse, horaires, instagram...).
model SiteSetting {
  key   String @id
  value String @default("")
}

// Artisans et équipe affichés sur la page « La Maison ». La photo est stockée dans la base (2 Mo maximum).
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String   @default("")
  email     String?
  phone     String?
  photo     Bytes?
  photoType String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
