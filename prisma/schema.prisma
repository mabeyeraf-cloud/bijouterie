// Schéma de base de données du site Groupe SAGFA.
// Montants en FCFA (entiers, sans décimales).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum Interval {
  MONTH
  YEAR
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum PaymentProvider {
  WAVE
  ORANGE_MONEY
  STRIPE
}

enum AppointmentStatus {
  NEW
  CONFIRMED
  DONE
  CANCELED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  orders       Order[]
  subscriptions Subscription[]
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  active      Boolean @default(true)
  plans       Plan[]
}

model Plan {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  label     String
  interval  Interval
  priceXof  Int
  active    Boolean  @default(true)
  orders    Order[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  planId    String
  plan      Plan        @relation(fields: [planId], references: [id])
  amountXof Int
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  payments  Payment[]
  subscription Subscription?
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id])
  provider    PaymentProvider
  providerRef String?         @unique
  amountXof   Int
  confirmedAt DateTime?
  createdAt   DateTime        @default(now())
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  orderId   String             @unique
  order     Order              @relation(fields: [orderId], references: [id])
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime
  renewsAt  DateTime
}

model AppointmentRequest {
  id        String            @id @default(cuid())
  name      String
  phone     String
  email     String?
  pole      String
  message   String?
  status    AppointmentStatus @default(NEW)
  kind          String   @default("CONTACT") // "RDV" (rendez-vous) ou "CONTACT" (message)
  wantedDate    String?                      // jour proposé par le visiteur, AAAA-MM-JJ
  wantedTime    String?                      // heure proposée, HH:MM
  confirmedDate String?                      // jour confirmé par l'équipe
  confirmedTime String?                      // heure confirmée par l'équipe
  createdAt DateTime          @default(now())
}

model Reference {
  id       String @id @default(cuid())
  name     String
  logoUrl  String?
  position Int    @default(0)
}

model KeyFigure {
  id       String @id @default(cuid())
  label    String
  value    String
  position Int    @default(0)
}

// Compte d'accès à l'espace adhérent IPM.
// Les données de santé restent dans le logiciel IPM existant : on ne stocke ici que l'accès.
model Adherent {
  id              String    @id @default(cuid())
  memberNumber    String    @unique
  phone           String
  passwordHash    String
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
}

// Coordonnées du site modifiables depuis /admin (clé = telephone, whatsapp, email, adresse, horaires, facebook...).
model SiteSetting {
  key   String @id
  value String @default("")
}

// Membres de l'équipe affichés sur la page « À propos ». La photo est stockée dans la base (2 Mo maximum).
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String   @default("")
  email     String?
  phone     String?
  photo     Bytes?
  photoType String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
