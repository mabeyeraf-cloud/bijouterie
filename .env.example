# Copie ce fichier en .env et remplis les valeurs. Ne commit JAMAIS le fichier .env.
# En ligne (Vercel), ces valeurs se saisissent dans Settings › Environment Variables.
DATABASE_URL="postgresql://bijouterie:bijouterie@localhost:5432/bijouterie"

# Adresse publique du site et coordonnées par défaut
# (elles se modifient ensuite dans /admin › Coordonnées du site)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP=""          # avec l'indicatif, sans + ni espace, ex. 221770000000
NEXT_PUBLIC_PHONE=""             # tel qu'affiché, ex. +221 77 000 00 00

# Session de l'administration : une longue phrase secrète, propre à ce site
AUTH_SECRET=""

# Compte administrateur créé par « npm run db:seed » : choisis un mot de passe fort, propre à ce site
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Envoi des emails (alertes de rendez-vous et confirmations)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL=""
